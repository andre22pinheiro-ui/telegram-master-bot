GOOGLE_SERVICE_ACCOUNT_KEY=
# Ou caminho para o ficheiro de credenciais:
GOOGLE_SERVICE_ACCOUNT_PATH=./service-account.json
# ID opcional da pasta de destino no Google Drive (se quiseres que guarde numa pasta específica):
GOOGLE_DRIVE_FOLDER_ID=

# ── CONFIGURAÇÃO ──────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
PORT=3000
