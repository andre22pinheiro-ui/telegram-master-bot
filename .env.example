# ── BOT TELEGRAM ÚNICO (@AndrePinheirobot) ─────────────────────────────────
TELEGRAM_BOT_TOKEN_MASTER=
CHAT_ID_AUTORIZADO=950415577
CHAT_ID_ESPOSA=

# ── INTELIGÊNCIA ARTIFICIAL (CASCATA temperature: 0.0) ────────────────────────
# Primário: Gemini -> Secundário: Groq -> Terciário: OpenRouter
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
OPENROUTER_API_KEY=

# ── GITHUB / SELF-REFINE ──────────────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_OWNER=

# ── CLOUDINARY (MULTIMÉDIA) ───────────────────────────────────────────────────
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_URL=
CLOUDINARY_UPLOAD_PRESET=ml_default

# ── EMAIL IMAP PESSOAL ────────────────────────────────────────────────────────
EMAIL_USER=
EMAIL_PASS=
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993
EMAIL_SECURE=true

# ── GOOGLE DRIVE (BACKUPS SQLITE WAL) ─────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_SERVICE_ACCOUNT_PATH=./service-account.json
GOOGLE_DRIVE_FOLDER_ID=

# ── WEBAPP & CLOUD-NATIVE RENDER / VERCEL ────────────────────────────────────
TELEGRAM_WEBAPP_URL=https://gestao-familiar-webapp.vercel.app
RENDER_EXTERNAL_URL=https://telegram-master-bot-0h2h.onrender.com
VERCEL_DEPLOY_HOOK_URL=

# ── SERVIDOR ──────────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
PORT=3000
